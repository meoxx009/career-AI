# CareerAI Environment Configuration
# CareerAI works out-of-the-box in deterministic fallback mode without any API keys.

# Optional: Supabase configuration (client publishable key only; RLS enforced)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
# Alias for backwards compatibility:
# VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Auth Redirect URLs:
# Configure in Supabase Dashboard -> Authentication -> URL Configuration:
# - Site URL: http://localhost:5173
# - Redirect URLs:
#   http://localhost:5173/settings
#   http://localhost:5173/dashboard
#   https://your-production-domain.com/settings

# Security Notice:
# NEVER commit secret service-role or AI keys in client bundles or public repositories.
